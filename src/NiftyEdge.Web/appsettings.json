{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NiftyEdge": "Server=(localdb)\\MSSQLLocalDB;Database=NiftyEdge;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Crypto": {
    "Enabled": true,
    "RiskPercentPerTrade": 1.0,
    "AccountEquityUsdt": 10000,
    "SignalCooldownHours": 4,
    "MaxSignalAgeHours": 12,
    "ConfidenceThreshold": 70,
    "MaxSuggestedLeverage": 5,
    "DefaultSuggestedLeverage": 2,
    "PreferredPairMode": "TopN",
    "PreferredPairCount": 3,
    "AlertOnlyPromotedStrategies": true,
    "UseWebSocketStream": false,
    "RestPollSeconds": 30,
    "PromotionGates": {
      "MinOutOfSampleTrades": 30,
      "MinExpectancyR": 0.01,
      "MinProfitFactor": 1.2,
      "MaxDrawdownR": 10,
      "MaxAverageHoldingHours": 12,
      "AssumedRoundTripCostR": 0.05
    },
    "Pairs": [
      { "Symbol": "ETHUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 },
      { "Symbol": "SOLUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 },
      { "Symbol": "BNBUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 },
      { "Symbol": "XRPUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 },
      { "Symbol": "LINKUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 },
      { "Symbol": "ADAUSDT", "Enabled": true, "Preferred": false, "SuggestedLeverage": 2 }
    ]
  }
}
