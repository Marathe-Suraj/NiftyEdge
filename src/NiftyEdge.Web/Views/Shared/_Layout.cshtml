<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - NiftyEdge</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top bg-white border-bottom">
            <div class="container-fluid px-3 px-md-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-mark d-inline-flex align-items-center justify-content-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="3 17 9 11 13 15 21 6"></polyline>
                            <polyline points="15 6 21 6 21 12"></polyline>
                        </svg>
                    </span>
                    <span class="fw-bold">NiftyEdge</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Dashboard")" aria-current="@NavAriaCurrent("Dashboard")" asp-controller="Dashboard" asp-action="Index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                                    <rect x="3" y="3" width="7" height="9" rx="1.5"></rect>
                                    <rect x="14" y="3" width="7" height="5" rx="1.5"></rect>
                                    <rect x="14" y="12" width="7" height="9" rx="1.5"></rect>
                                    <rect x="3" y="16" width="7" height="5" rx="1.5"></rect>
                                </svg>
                                Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("CryptoDashboard")" aria-current="@NavAriaCurrent("CryptoDashboard")" asp-controller="CryptoDashboard" asp-action="Index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <path d="M9.5 9.5c.5-1 1.5-1.5 2.5-1.5 1.5 0 2.5.8 2.5 2s-1 1.8-2.5 2.2-2.5.8-2.5 2.2 1 2 2.5 2c1 0 2-.5 2.5-1.5"></path>
                                    <line x1="12" y1="6" x2="12" y2="7.5"></line>
                                    <line x1="12" y1="16.5" x2="12" y2="18"></line>
                                </svg>
                                Crypto Signals
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("SignalHistory")" aria-current="@NavAriaCurrent("SignalHistory")" asp-controller="SignalHistory" asp-action="Index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                                    <circle cx="12" cy="12" r="9"></circle>
                                    <polyline points="12 7 12 12 15.5 14"></polyline>
                                </svg>
                                Equity Signals
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Settings")" aria-current="@NavAriaCurrent("Settings")" asp-controller="Settings" asp-action="Index">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="nav-link-icon">
                                    <circle cx="12" cy="12" r="3"></circle>
                                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                                </svg>
                                Settings
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-3 px-md-4 flex-grow-1">
        <main role="main" class="pb-5 pt-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white py-3">
        <div class="container-fluid px-3 px-md-4 d-flex flex-wrap justify-content-center align-items-center gap-2 gap-md-3 small text-muted text-center">
            <span>&copy; @DateTime.Now.Year NiftyEdge</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string NavActive(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";

    private string? NavAriaCurrent(string controller) =>
        NavActive(controller) == "active" ? "page" : null;
}
