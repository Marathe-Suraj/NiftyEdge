@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-heading">
    <div>
        <h4 class="fw-bold">Market Dashboard_1</h4>
        <div class="page-subtitle">Live prices, charts and active trade signals across your watchlist.</div>
    </div>
</div>

@if (ViewBag.DatabaseError == true)
{
    <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
        <div>
            Could not load market data &mdash; the database isn't reachable. Check the <code>NiftyEdge</code> connection
            string in <code>appsettings.json</code> and make sure SQL Server / LocalDB is running, then refresh.
        </div>
    </div>
}
else if (!Model.Instruments.Any())
{
    <div class="alert alert-warning" role="alert">
        No active instruments configured yet. Seed data should have added Nifty 50, Bank Nifty, Sensex and
        Fin Nifty automatically on first run &mdash; try restarting the app.
    </div>
}

<div class="row g-3" id="instrumentCards">
    @foreach (var instrument in Model.Instruments)
    {
        <div class="col-12 col-xl-6">
            <div class="card instrument-card h-100" data-instrument-id="@instrument.InstrumentId"
                 data-ltp="@instrument.Ltp.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                 data-ltp-time="@instrument.LtpAsOfUnixSeconds">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div>
                        <span class="fw-bold instrument-name">@instrument.DisplayName</span>
                        <span class="text-muted small ms-2 instrument-symbol">@instrument.Symbol</span>
                    </div>
                    <div class="text-end d-flex align-items-center gap-2">
                        <span class="fs-5 fw-semibold ltp-value">@instrument.Ltp.ToString("N2")</span>
                        <span class="badge rounded-pill change-badge @(instrument.ChangePercent >= 0 ? "text-bg-success" : "text-bg-danger")">
                            @(instrument.ChangePercent >= 0 ? "+" : "")@instrument.ChangePercent.ToString("N2")%
                        </span>
                        <span class="badge rounded-pill bias-badge @BiasBadgeClass(instrument.Bias)">@instrument.Bias</span>
                    </div>
                </div>
                <div class="card-body">
                    @if (instrument.HasData)
                    {
                        <div class="chart-container" id="chart-@instrument.InstrumentId" style="height: 260px;"></div>
                    }
                    else
                    {
                        <div class="text-muted small text-center py-4 border rounded-3">No candle data yet &mdash; waiting for the first market-hours poll.</div>
                    }

                    @if (instrument.OptionChainSummary is not null)
                    {
                        var oc = instrument.OptionChainSummary;
                        <div class="option-chain-strip mt-3 d-flex flex-wrap align-items-center gap-2">
                            <div class="stat-chip">
                                <span class="stat-label">PCR</span>
                                <span class="stat-value">@oc.Pcr.ToString("N2")</span>
                            </div>
                            <div class="stat-chip">
                                <span class="stat-label">Max Call OI</span>
                                <span class="stat-value">@(oc.MaxCallOiStrike?.ToString("N0") ?? "-")</span>
                            </div>
                            <div class="stat-chip">
                                <span class="stat-label">Max Put OI</span>
                                <span class="stat-value">@(oc.MaxPutOiStrike?.ToString("N0") ?? "-")</span>
                            </div>
                            <div class="stat-chip">
                                <span class="stat-label">Max Pain</span>
                                <span class="stat-value">@(oc.MaxPainStrike?.ToString("N0") ?? "-")</span>
                            </div>
                            <span class="text-muted small ms-auto">as of @MarketHoursCalculator.UtcToIst(oc.CaptureTime).ToString("HH:mm") IST</span>
                        </div>
                    }

                    <div class="signals-panel mt-3" id="signals-@instrument.InstrumentId">
                        <div class="signals-panel-heading mb-2">Active Signals</div>
                        @if (!instrument.ActiveSignals.Any())
                        {
                            <div class="text-muted small no-signal-message">No active signal right now.</div>
                        }
                        else
                        {
                            foreach (var signal in instrument.ActiveSignals)
                            {
                                @await Html.PartialAsync("_SignalCard", signal)
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script id="candle-data" type="application/json">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Instruments.ToDictionary(i => i.InstrumentId, i => i.Candles)))
</script>

@section Scripts {
    <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}

@functions
{
    private static string BiasBadgeClass(string bias) => bias switch
    {
        "Bullish" => "text-bg-success",
        "Bearish" => "text-bg-danger",
        _ => "text-bg-secondary"
    };
}
