@model CryptoSettingsPageViewModel
@{
    ViewData["Title"] = "Settings";
}

<div class="page-heading">
    <div>
        <h4 class="fw-bold">Settings</h4>
        <div class="page-subtitle">Manage Telegram alerts and crypto trading.</div>
    </div>
</div>

<partial name="_SettingsTabs" model="Model.ActiveTab" />

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-success">@Model.StatusMessage</div>
}

@if (Model.DatabaseError)
{
    <div class="alert alert-danger">Could not load crypto settings from the database.</div>
}

<div class="card settings-section-card mb-3">
    <div class="card-body p-4">
        <div class="settings-section-header mb-3">
            <h6 class="fw-bold mb-1">Runtime configuration</h6>
            <div class="text-muted small">Read-only values from the Crypto section in <code>appsettings.json</code>.</div>
        </div>
        <div class="row g-3 small">
            <div class="col-6 col-md-4">
                <div class="text-muted">Module enabled</div>
                <div class="fw-semibold">@Model.CryptoEnabled</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted">Account equity</div>
                <div class="fw-semibold">@Model.AccountEquity USDT</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted">Risk / trade</div>
                <div class="fw-semibold">@Model.RiskPercent%</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted">Signal cooldown</div>
                <div class="fw-semibold">@Model.DataHours h</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted">Max signal age</div>
                <div class="fw-semibold">@Model.MaxAgeHours h</div>
            </div>
            <div class="col-6 col-md-4">
                <div class="text-muted">Confidence threshold</div>
                <div class="fw-semibold">@Model.ConfidenceThreshold</div>
            </div>
        </div>
        <div class="text-muted small mt-3 mb-0">No API keys required for public market data.</div>
    </div>
</div>

<div class="card settings-section-card mb-3">
    <div class="card-body p-4">
        <div class="settings-section-header mb-3">
            <h6 class="fw-bold mb-1">Promoted strategies</h6>
            <div class="text-muted small">
                Alert-only-promoted is <strong>@(Model.AlertOnlyPromoted ? "ON" : "OFF")</strong>.
                @if (Model.AlertOnlyPromoted)
                {
                    <span>Only the strategies ticked below can raise live crypto alerts. If none are ticked, no crypto signals are produced at all.</span>
                }
                else
                {
                    <span>All strategies can alert regardless of this list.</span>
                }
            </div>
        </div>

        @if (!Model.PromotedStrategies.Any() && Model.AlertOnlyPromoted)
        {
            <div class="alert alert-warning py-2 small">No strategy is promoted, so crypto alerts are currently suppressed.</div>
        }

        <form asp-controller="Settings" asp-action="SavePromotedStrategies" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                @foreach (var name in Model.AllStrategies)
                {
                    <div class="col-12 col-md-6">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="promoted" value="@name" id="st-@name.GetHashCode()" @(Model.PromotedStrategies.Contains(name) ? "checked" : null) />
                            <label class="form-check-label" for="st-@name.GetHashCode()">@name</label>
                        </div>
                    </div>
                }
            </div>
            <button class="btn btn-primary btn-sm mt-3" type="submit">Save promoted strategies</button>
        </form>
        <div class="text-muted small mt-2 mb-0">
            Promote only what cleared the walk-forward gates in <code>backtests/reports/</code>. Past performance does not guarantee future results.
        </div>
    </div>
</div>

<div class="settings-section-header mb-2">
    <h6 class="fw-bold mb-1">Pair settings</h6>
    <div class="text-muted small">Enable pairs, mark preferred, and set suggested leverage (advisory only).</div>
</div>

<div class="row g-3">
@foreach (var p in Model.Pairs)
{
    <div class="col-12 col-md-6">
        <div class="card settings-section-card h-100">
            <div class="card-body">
                <form asp-controller="Settings" asp-action="SavePair" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="symbol" value="@p.Symbol" />
                    <div class="col-12"><strong>@p.Symbol</strong></div>
                    <div class="col-4">
                        <div class="form-check">
                            <input type="hidden" name="isEnabled" value="false" />
                            <input class="form-check-input" type="checkbox" name="isEnabled" value="true" id="en-@p.Symbol" @(p.IsEnabled ? "checked" : null) />
                            <label class="form-check-label" for="en-@p.Symbol">Enabled</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="form-check">
                            <input type="hidden" name="isPreferred" value="false" />
                            <input class="form-check-input" type="checkbox" name="isPreferred" value="true" id="pr-@p.Symbol" @(p.IsPreferred ? "checked" : null) />
                            <label class="form-check-label" for="pr-@p.Symbol">Preferred</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <label class="form-label small mb-0">Leverage</label>
                        <input class="form-control form-control-sm" type="number" min="1" max="5" name="suggestedLeverage" value="@p.SuggestedLeverage" />
                    </div>
                    <div class="col-12">
                        <button class="btn btn-sm btn-primary" type="submit">Save</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
</div>
