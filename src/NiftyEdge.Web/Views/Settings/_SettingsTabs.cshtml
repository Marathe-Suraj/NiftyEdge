@model SettingsTab
@{
    var active = Model;
}

<ul class="nav settings-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(active == SettingsTab.Telegram ? "active" : null)"
           asp-controller="Settings" asp-action="Index">Telegram &amp; Alerts</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(active == SettingsTab.Crypto ? "active" : null)"
           asp-controller="Settings" asp-action="Crypto">Crypto Trading</a>
    </li>
</ul>
